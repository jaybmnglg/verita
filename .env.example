# ==============================================================================
# Verita Frontend — Environment Variables
# ==============================================================================
# Configure the connection to your n8n backend workflow.
# Copy this file to `.env.local` and fill in your actual values.
# DO NOT commit real secrets or production webhook URLs to source control.
# ==============================================================================

# Option 1: Direct full Webhook URL for the Chatbot Workflow
# Format: https://<your-n8n-domain>/webhook/<webhookId>/chat
# Or for test mode: https://<your-n8n-domain>/webhook-test/<webhookId>/chat
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/c755f93c-2603-45f4-b463-d5ad48ccec0b/chat

# Option 2: Base Host URL for your n8n instance (if N8N_WEBHOOK_URL is not set)
# The server proxy will automatically append `/webhook/<N8N_WEBHOOK_ID>/chat`
N8N_BASE_URL=https://your-n8n-instance.com

# Optional: Override the Webhook ID extracted from verita.json (default: c755f93c-2603-45f4-b463-d5ad48ccec0b)
N8N_WEBHOOK_ID=c755f93c-2603-45f4-b463-d5ad48ccec0b

# Optional: Bearer token or API key if your n8n webhook requires authentication headers
N8N_API_KEY=
